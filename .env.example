# VITE_API_BASE_URL: Backend API base URL. Leave empty to call same-origin endpoints.
VITE_API_BASE_URL=""

# APP_URL: Public URL of this frontend application.
APP_URL="http://localhost:3000"

# Go/Gin API listen port.
PORT=3001

# Vite development proxy target for frontend /api requests.
ALLIANCE_API_ORIGIN="http://localhost:3001"

# Built frontend directory served by the Go backend when index.html exists.
ALLIANCE_PUBLIC_DIR="./dist/public"

# Required in production. Use a random value with at least 32 characters.
AUTH_SECRET="replace-with-a-random-production-secret"

# Comma-separated browser origins allowed to call the API.
ALLIANCE_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# SQLite database path used by the Go backend.
ALLIANCE_SQLITE_PATH="./alliance.sqlite"

# Legacy JSON seed input. Used only by db:migrate.
ALLIANCE_JSON_SEED_PATH="./db.json"
